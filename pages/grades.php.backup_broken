<script>
// Validate grade input (0-100 only)
function validateGrade(input) {
    let value = parseFloat(input.value);
    
    // Remove invalid characters and limit to 2 decimal places
    if (input.value !== '') {
        if (value < 0) {
            input.value = 0;
            input.style.borderColor = '#dc3545';
            setTimeout(() => input.style.borderColor = '', 1500);
        } else if (value > 100) {
            input.value = 100;
            input.style.borderColor = '#dc3545';
            setTimeout(() => input.style.borderColor = '', 1500);
        } else {
            input.style.borderColor = '';
        }
    }
}

// Tab Management
let tabCounter = 0;
let activeTabs = [];

function addNewTab() {
    // Create a new tab with student selector
    tabCounter++;
    const tabId = 'tab-' + tabCounter;
    
    // Create tab button
    const tabNav = document.querySelector('.grades-tabs');
    const addButton = document.querySelector('.add-tab-btn');
    
    const tabButton = document.createElement('button');
    tabButton.className = 'grade-tab';
    tabButton.id = tabId + '-btn';
    tabButton.addEventListener('click', () => switchTab(tabId));
    tabButton.innerHTML = `
        <i class="bi bi-person-circle"></i>
        <span>Select Student</span>
        <span class="close-tab">×</span>
    `;
    
    // Add close button event listener
    const closeBtn = tabButton.querySelector('.close-tab');
    closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeTab(tabId);
    });
    
    tabNav.insertBefore(tabButton, addButton);
    
    // Create tab content with student selector
    const contentContainer = document.getElementById('content-container');
    const tabContent = document.createElement('div');
    tabContent.className = 'tab-content';
    tabContent.id = tabId + '-content';
    tabContent.innerHTML = `
        <div class="selection-card">
            <h5><i class="bi bi-person-circle"></i> Select Student for This Tab</h5>
            <form method="GET" onsubmit="return false;">
                <select id="studentSelector_${tabId}" class="form-select form-select-lg" required>
                    <option value="">-- Choose a student --</option>
                    <?php 
                    $students->data_seek(0);
                    while($s = $students->fetch_assoc()): 
                    ?>
                    <option value="<?= $s['id'] ?>" data-name="<?= htmlspecialchars($s['fullname']) ?>">
                        <?= htmlspecialchars($s['fullname']) ?>
                    </option>
                    <?php endwhile; ?>
                </select>
            </form>
        </div>

        <div class="empty-state">
            <i class="bi bi-clipboard-data"></i>
            <h4>Select a Student</h4>
            <p>Choose a student from the dropdown above to start entering grades</p>
        </div>
    `;
    
    contentContainer.appendChild(tabContent);
    
    // Attach event listener to the new tab's student selector
    const selector = document.getElementById('studentSelector_' + tabId);
    selector.addEventListener('change', function() {
        loadStudentInTab(tabId, this.value);
    });
    
    // Switch to new tab and focus
    switchTab(tabId);
    setTimeout(() => {
        selector.focus();
        selector.style.borderColor = 'var(--primary-teal)';
        selector.style.boxShadow = '0 0 0 3px rgba(79, 171, 169, 0.3)';
        setTimeout(() => {
            selector.style.borderColor = '';
            selector.style.boxShadow = '';
        }, 1500);
    }, 100);
}

function loadStudentInTab(tabId, studentId) {
    if (!studentId) return;
    
    console.log('loadStudentInTab called:', {tabId, studentId});
    
    // Check if student already has a tab open
    if (activeTabs.find(tab => tab.studentId == studentId)) {
        alert('This student already has a tab open!');
        document.getElementById('studentSelector_' + tabId).value = '';
        return;
    }
    
    // Get student info
    const selector = document.getElementById('studentSelector_' + tabId);
    const studentName = selector.options[selector.selectedIndex].text;
    
    console.log('Student name:', studentName);
    
    // Update tab button to show student name
    const tabButton = document.getElementById(tabId + '-btn');
    tabButton.innerHTML = `
        <i class="bi bi-person-fill"></i>
        <span>${studentName}</span>
        <span class="close-tab">×</span>
    `;
    
    // Re-attach close button event listener
    const closeBtn = tabButton.querySelector('.close-tab');
    closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeTab(tabId);
    });
    
    // Add to active tabs
    activeTabs.push({
        id: tabId,
        studentId: studentId,
        name: studentName
    });
    
    console.log('Calling loadStudentData...');
    // Load student data
    loadStudentData(tabId, studentId, studentName);
    
    // Save to localStorage
    saveTabsToStorage();
}

function addStudentTab(studentId) {
    if (!studentId) return;
    
    // Check if student already has a tab open
    if (activeTabs.find(tab => tab.studentId == studentId)) {
        alert('This student already has a tab open!');
        document.getElementById('studentSelector').value = '';
        return;
    }
    
    // Get student info
    const selector = document.getElementById('studentSelector');
    const studentName = selector.options[selector.selectedIndex].text;
    
    // Load student into main tab
    loadStudentIntoMainTab(studentId, studentName);
    
    // Reset selector
    document.getElementById('studentSelector').value = '';
}

function loadStudentIntoMainTab(studentId, studentName) {
    // Update main tab button to show student name
    const mainTabBtn = document.getElementById('main-tab-btn');
    mainTabBtn.innerHTML = `
        <i class="bi bi-person-fill"></i>
        <span>${studentName}</span>
    `;
    
    // Add to active tabs
    activeTabs.push({
        id: 'main-tab',
        studentId: studentId,
        name: studentName
    });
    
    // Load student data into main tab
    loadStudentData('main-tab', studentId, studentName);
    
    // Save to localStorage
    saveTabsToStorage();
}
    tabCounter++;
    const tabId = 'tab-' + tabCounter;
    
    // Add to active tabs
    activeTabs.push({
        id: tabId,
        studentId: studentId,
        name: studentName
    });
    
    // Create tab button
    const tabNav = document.querySelector('.grades-tabs');
    const addButton = document.querySelector('.add-tab-btn');
    
    const tabButton = document.createElement('button');
    tabButton.className = 'grade-tab';
    tabButton.id = tabId + '-btn';
    tabButton.onclick = () => switchTab(tabId);
    tabButton.innerHTML = `
        <i class="bi bi-person-fill"></i>
        <span>${studentName}</span>
        <span class="close-tab" onclick="event.stopPropagation(); closeTab('${tabId}');">×</span>
    `;
    
    tabNav.insertBefore(tabButton, addButton);
    
    // Create tab content
    createTabContent(tabId, studentId, studentName);
    
    // Switch to new tab
    switchTab(tabId);
    
    // Reset selector
    document.getElementById('studentSelector').value = '';
    
    // Save to localStorage
    saveTabsToStorage();
}

function switchTab(tabId) {
    // Update tab buttons
    document.querySelectorAll('.grade-tab').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Update tab content
    document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.remove('active');
    });
    
    if (tabId === 'main-tab') {
        document.getElementById('main-tab-btn').classList.add('active');
        document.getElementById('main-tab-content').classList.add('active');
    } else {
        document.getElementById(tabId + '-btn').classList.add('active');
        document.getElementById(tabId + '-content').classList.add('active');
    }
}

function closeTab(tabId) {
    if (confirm('Close this student tab? Unsaved changes will be lost.')) {
        // Remove from active tabs
        activeTabs = activeTabs.filter(tab => tab.id !== tabId);
        
        // If closing main tab, reset it
        if (tabId === 'main-tab') {
            addNewTab();
        } else {
            // Remove tab button and content
            document.getElementById(tabId + '-btn')?.remove();
            document.getElementById(tabId + '-content')?.remove();
            
            // Switch to main tab
            switchTab('main-tab');
        }
        
        // Save to localStorage
        saveTabsToStorage();
    }
}

function createTabContent(tabId, studentId, studentName) {
    const contentContainer = document.getElementById('content-container');
    
    const tabContent = document.createElement('div');
    tabContent.className = 'tab-content';
    tabContent.id = tabId + '-content';
    tabContent.innerHTML = `
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading ${studentName}'s data...</p>
        </div>
    `;
    
    contentContainer.appendChild(tabContent);
    
    // Load student data via AJAX
    loadStudentData(tabId, studentId, studentName);
}

function loadStudentData(tabId, studentId, studentName) {
    console.log('loadStudentData called:', {tabId, studentId, studentName});
    
    const tabContent = document.getElementById(tabId + '-content');
    console.log('Tab content element:', tabContent);
    
    if (!tabContent) {
        console.error('Tab content not found for:', tabId);
        return;
    }
    
    // Fetch school history for this student
    fetch(`grades.php?ajax=get_student_data&student_id=${studentId}`)
        .then(response => {
            console.log('AJAX response status:', response.status);
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            console.log('AJAX data received:', data);
            renderGradeForm(tabId, studentId, studentName, data);
        })
        .catch(error => {
            console.error('Error loading student data:', error);
            document.getElementById(tabId + '-content').innerHTML = `
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> Error loading student data: ${error.message}
                </div>
            `;
        });
}

function renderGradeForm(tabId, studentId, studentName, data) {
    console.log('renderGradeForm called:', {tabId, studentId, studentName, data});
    
    const tabContent = document.getElementById(tabId + '-content');
    console.log('Tab content in renderGradeForm:', tabContent);
    
    if (!tabContent) {
        console.error('Cannot render: tab content not found for', tabId);
        return;
    }
    
    // Build school history options
    let schoolOptions = '<option value="">-- Select school record --</option>';
    if (data.school_history) {
        data.school_history.forEach(history => {
            schoolOptions += `<option value="${history.id}">${history.label}</option>`;
        });
    }
    
    // Build subjects rows
    let subjectRows = '';
    const subjects = <?= json_encode($subjects) ?>;
    subjects.forEach(subject => {
        // Skip General Average
        if (subject.subject_name === 'General Average') return;
        
        const isMapeh = (subject.subject_name === 'MAPEH');
        const isMapehComponent = ['Music', 'Arts', 'P.E.', 'Health'].includes(subject.subject_name);
        
        const rowClass = isMapehComponent ? 'class="mapeh-row"' : '';
        
        // Start building the row
        subjectRows += '<tr ' + rowClass + '><td>' + subject.subject_name + '</td>';
        
        // MAPEH row shows calculated values, not inputs (styled like inputs for consistency)
        if (isMapeh) {
            subjectRows += '<td><div class="mapeh-display" id="mapehQ1_' + tabId + '">0.00</div></td>';
            subjectRows += '<td><div class="mapeh-display" id="mapehQ2_' + tabId + '">0.00</div></td>';
            subjectRows += '<td><div class="mapeh-display" id="mapehQ3_' + tabId + '">0.00</div></td>';
            subjectRows += '<td><div class="mapeh-display" id="mapehQ4_' + tabId + '">0.00</div></td>';
        } else {
            // Regular subjects and MAPEH components get input fields
            for (let q = 1; q <= 4; q++) {
                subjectRows += '<td><input type="number" step="0.01" min="0" max="100" inputmode="decimal" name="grades_' + tabId + '[' + subject.id + '][q' + q + ']" class="grade-input" oninput="validateGrade(this); window[\'calculateFinalRating_' + tabId + '\'](' + subject.id + '); window[\'calculateMAPEH_' + tabId + '\'](); window[\'calculateGeneralAverage_' + tabId + '\']();"></td>';
            }
        }
        
        // Add final rating and remarks
        subjectRows += '<td><input type="number" step="0.01" min="0" max="100" inputmode="decimal" name="grades_' + tabId + '[' + subject.id + '][final_rating]" class="grade-input" readonly style="background:#e9ecef;"></td>';
        subjectRows += '<td><input type="text" name="grades_' + tabId + '[' + subject.id + '][remarks]" class="grade-input" readonly style="background:#e9ecef;"></td>';
        subjectRows += '</tr>';
    });
    
    tabContent.innerHTML = `
        <form method="POST" class="tab-form" id="form-${tabId}">
            <input type="hidden" name="student_id" value="${studentId}">
            
            <div class="selection-card">
                <h5><i class="bi bi-building"></i> School Record & School Year - ${studentName}</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">School Record</label>
                        <select name="school_attended_id" class="form-select" required>
                            ${schoolOptions}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">School Year</label>
                        <input type="text" name="school_year" class="form-control" placeholder="e.g., 2024-2025" required>
                    </div>
                </div>
            </div>

            <div class="grades-table-wrapper">
                <div class="table-responsive">
                    <table class="grades-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Learning Area</th>
                                <th style="width: 12%;">Quarter 1</th>
                                <th style="width: 12%;">Quarter 2</th>
                                <th style="width: 12%;">Quarter 3</th>
                                <th style="width: 12%;">Quarter 4</th>
                                <th style="width: 14%;">Final Rating</th>
                                <th style="width: 13%;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${subjectRows}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="summary-card">
                <h5><i class="bi bi-calculator"></i> General Average</h5>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Quarter 1</th>
                                <th>Quarter 2</th>
                                <th>Quarter 3</th>
                                <th>Quarter 4</th>
                                <th>General Average</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="gaQ1_${tabId}">0.00</td>
                                <td id="gaQ2_${tabId}">0.00</td>
                                <td id="gaQ3_${tabId}">0.00</td>
                                <td id="gaQ4_${tabId}">0.00</td>
                                <td><strong id="generalAverage_${tabId}">0.00</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="text-end">
                <button type="submit" name="save_grades" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Grades for ${studentName}
                </button>
            </div>
