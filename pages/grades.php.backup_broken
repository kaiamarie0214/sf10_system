    `;
    
    // Create calculation functions for this tab
    createCalculationFunctions(tabId);
    
    // Debug: Log that functions were created
    console.log('Created calculation functions for:', tabId);
}

function createCalculationFunctions(tabId) {
    console.log('Creating functions for tab:', tabId);
    
    // Create scoped calculation functions for this tab
    window['calculateFinalRating_' + tabId] = function(subjectId) {
        console.log('calculateFinalRating called for tab:', tabId, 'subject:', subjectId);
        
        let q1 = parseFloat(document.querySelector(`[name="grades_${tabId}[${subjectId}][q1]"]`)?.value) || 0;
        let q2 = parseFloat(document.querySelector(`[name="grades_${tabId}[${subjectId}][q2]"]`)?.value) || 0;
        let q3 = parseFloat(document.querySelector(`[name="grades_${tabId}[${subjectId}][q3]"]`)?.value) || 0;
        let q4 = parseFloat(document.querySelector(`[name="grades_${tabId}[${subjectId}][q4]"]`)?.value) || 0;

        console.log('Values:', {q1, q2, q3, q4});

        let count = 0, sum = 0;
        if (q1 > 0) { sum += q1; count++; }
        if (q2 > 0) { sum += q2; count++; }
        if (q3 > 0) { sum += q3; count++; }
        if (q4 > 0) { sum += q4; count++; }
        if (q3 > 0) { sum += q3; count++; }
        if (q4 > 0) { sum += q4; count++; }

        if (count > 0) {
            let finalRating = (sum / count).toFixed(2);
            document.querySelector(`[name="grades_${tabId}[${subjectId}][final_rating]"]`).value = finalRating;
            document.querySelector(`[name="grades_${tabId}[${subjectId}][remarks]"]`).value = (finalRating >= 75 ? "Passed" : "Failed");
        } else {
            document.querySelector(`[name="grades_${tabId}[${subjectId}][final_rating]"]`).value = '';
            document.querySelector(`[name="grades_${tabId}[${subjectId}][remarks]"]`).value = '';
        }
    };

    window['calculateMAPEH_' + tabId] = function() {
        const ids = [9, 10, 11, 12]; // Music, Arts, PE, Health
        let quarterValues = [];

        for (let q = 1; q <= 4; q++) {
            let total = 0, count = 0;
            ids.forEach(id => {
                let val = parseFloat(document.querySelector(`[name="grades_${tabId}[${id}][q${q}]"]`)?.value) || 0;
                if (val > 0) { total += val; count++; }
            });

            let avg = (count > 0) ? (total / count).toFixed(2) : "0.00";
            const cell = document.getElementById(`mapehQ${q}_${tabId}`);
            if (cell) cell.innerText = avg;
            quarterValues[q-1] = parseFloat(avg);
        }

        if (quarterValues.filter(v => v > 0).length === 4) {
            let final = (quarterValues.reduce((a,b)=>a+b,0)/4).toFixed(2);
            let finalInput = document.querySelector(`[name="grades_${tabId}[8][final_rating]"]`);
            if(finalInput){
                finalInput.value = final;
                document.querySelector(`[name="grades_${tabId}[8][remarks]"]`).value = (final >= 75 ? "Passed" : "Failed");
            }
        }
    };

    window['calculateGeneralAverage_' + tabId] = function() {
        const skipIds = [9, 10, 11, 12]; // skip Music, Arts, PE, Health

        let quarterSums = [0, 0, 0, 0];
        let quarterCounts = [0, 0, 0, 0];
        let finalSum = 0, finalCount = 0;

        for (let q = 1; q <= 4; q++) {
            document.querySelectorAll(`input[name*="grades_${tabId}"][name*="[q${q}]"]`).forEach(input => {
                let subjectId = parseInt(input.name.match(/\[(\d+)\]/)[1]);
                let val = parseFloat(input.value) || 0;
                if (val && !skipIds.includes(subjectId)) {
                    quarterSums[q-1] += val;
                    quarterCounts[q-1]++;
                }
            });
            
            // Include MAPEH calculated quarter too
            if(document.getElementById(`mapehQ${q}_${tabId}`)){
                let mapehVal = parseFloat(document.getElementById(`mapehQ${q}_${tabId}`).innerText) || 0;
                if(mapehVal > 0){
                    quarterSums[q-1] += mapehVal;
                    quarterCounts[q-1]++;
                }
            }
        }

        document.querySelectorAll(`input[name*="grades_${tabId}"][name*="[final_rating]"]`).forEach(input => {
            let subjectId = parseInt(input.name.match(/\[(\d+)\]/)[1]);
            let val = parseFloat(input.value) || 0;
            if (val && !skipIds.includes(subjectId)) {
                finalSum += val;
                finalCount++;
            }
        });
        
        // Include MAPEH final too
        let mapehFinal = parseFloat(document.querySelector(`[name="grades_${tabId}[8][final_rating]"]`)?.value) || 0;
        if(mapehFinal > 0){
            finalSum += mapehFinal;
            finalCount++;
        }

        for(let i=0;i<4;i++){
            document.getElementById(`gaQ${i+1}_${tabId}`).textContent = quarterCounts[i] ? (quarterSums[i]/quarterCounts[i]).toFixed(2) : "0.00";
        }
        document.getElementById(`generalAverage_${tabId}`).textContent = finalCount ? (finalSum/finalCount).toFixed(2) : "0.00";
    };
}

function saveTabsToStorage() {
    localStorage.setItem('grades_active_tabs', JSON.stringify(activeTabs));
}

function loadTabsFromStorage() {
    const saved = localStorage.getItem('grades_active_tabs');
    if (saved) {
        const tabs = JSON.parse(saved);
        tabs.forEach(tab => {
            // Restore tabs (but need to fetch fresh data)
            const selector = document.getElementById('studentSelector');
            const option = Array.from(selector.options).find(opt => opt.value == tab.studentId);
            if (option) {
                setTimeout(() => {
                    selector.value = tab.studentId;
                    addStudentTab(tab.studentId);
                }, 100);
            }
        });
    }
}

